{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "images/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/index.html", "dest": "/index.html" },
    { "src": "/landing.html", "dest": "/landing.html" },
    { "src": "/login.html", "dest": "/login.html" },
    { "src": "/brand-dashboard.html", "dest": "/brand-dashboard.html" },
    { "src": "/supplier-dashboard.html", "dest": "/supplier-dashboard.html" },
    { "src": "/community.html", "dest": "/community.html" },
    { "src": "/new-order.html", "dest": "/new-order.html" },
    { "src": "/order-list.html", "dest": "/order-list.html" },
    { "src": "/order-detail.html", "dest": "/order-detail.html" },
    { "src": "/settlement.html", "dest": "/settlement.html" },
    { "src": "/dispatch.html", "dest": "/dispatch.html" },
    { "src": "/supplier-market.html", "dest": "/supplier-market.html" }
  ]
}
